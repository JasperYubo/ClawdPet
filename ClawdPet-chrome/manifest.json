{
  "manifest_version": 3,
  "name": "Clawd 桌宠",
  "version": "1.3.0",
  "description": "Clawd 住进你的网页：会坐会趴会打滚，跳到标题和图片上，能喂零食、扔球陪它玩，还会提醒你番茄钟、定时提醒和起来活动。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clawd 桌宠",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications", "idle", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
